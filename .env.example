# Copiar a `.env` (gitignored) o exportar. El token real lo genera el operador:
# 32 bytes CSPRNG en hex (64 chars). Jamás en logs, código ni fixtures.
PULSE_TOKEN=
PORT=3000
HOST_ID=vps
DOCKER_HOST=http://socket-proxy:2375
# Fuente del snapshot: `docker` (por defecto, producción) o `procesos` (taller de la VPS 89,
# sin Docker: cada «contenedor» es un proyecto del taller leído de /proc).
PULSE_FUENTE=docker
# Raíz de los proyectos cuando PULSE_FUENTE=procesos (por defecto /home/dev/taller).
PULSE_RAIZ_TALLER=
# Meta lenta Coolify (opcional; sin esto, sitioUuid/dominio vacíos):
COOLIFY_API_URL=
COOLIFY_TOKEN=
RUST_LOG=info
