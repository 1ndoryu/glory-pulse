# Copiar a `.env` (gitignored) o exportar. El token real lo genera el operador:
# 32 bytes CSPRNG en hex (64 chars). Jamás en logs, código ni fixtures.
PULSE_TOKEN=
PORT=3000
HOST_ID=vps
DOCKER_HOST=http://socket-proxy:2375
# Meta lenta Coolify (opcional; sin esto, sitioUuid/dominio vacíos):
COOLIFY_API_URL=
COOLIFY_TOKEN=
RUST_LOG=info
