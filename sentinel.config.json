{
  "schemaVersion": 2,
  "mode": "enforce",
  "project": {
    "primaryBranch": "main"
  },
  "guard": {
    "directCommands": {
      "npmScripts": [],
      "npxTools": [],
      "cargoSubcommands": [
        "check",
        "test",
        "clippy",
        "fmt"
      ],
      "tools": [
        "git"
      ]
    }
  },
  "analyzers": {
    "sentinel": {
      "enabled": true,
      "profile": "rust",
      "config": {
        "includePatterns": [
          "**/*.rs",
          "Cargo.toml",
          "Cargo.lock"
        ],
        "excludePatterns": [
          "**/target/**",
          "**/.git/**"
        ]
      }
    }
  },
  "runtime": {
    "minimumVersion": "0.7.21",
    "protocolVersion": 1,
    "lockFile": "sentinel.lock.json"
  },
  "directoryExceptions": [],
  "rules": {},
  "portableBoundaries": {
    "dom": [],
    "window": [],
    "services": [],
    "loggerModules": []
  }
}
